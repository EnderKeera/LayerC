{
  "schemaVersion": 1,
  "profileId": "modern",
  "continuousInput": {},
  "variables": [
    {
      "id": "dashes",
      "type": "int",
      "default": 0,
      "persistent": true
    }
  ],
  "automations": [
    {
      "id": "movement-tracker",
      "name": "Movement tracker",
      "enabled": true,
      "rules": [
        {
          "id": "count-dash",
          "priority": 0,
          "event": "cooldownTriggered",
          "source": "dash",
          "condition": { "op": "literal", "valueType": "bool", "value": true },
          "actions": [
            {
              "type": "incrementVariable",
              "target": "dashes",
              "value": { "op": "literal", "valueType": "int", "value": 1 }
            }
          ]
        },
        {
          "id": "burst-timer",
          "priority": 0,
          "event": "groupReady",
          "source": "movement",
          "condition": { "op": "literal", "valueType": "bool", "value": true },
          "actions": [
            {
              "type": "setVariable",
              "target": "dashes",
              "value": { "op": "literal", "valueType": "int", "value": 0 }
            }
          ]
        }
      ]
    }
  ]
}
