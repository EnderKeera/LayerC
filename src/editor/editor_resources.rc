#include "editor_resource.h"
#include <windows.h>

// First icon: Explorer, taskbar and the title bar (set_window_app_icon).
1 ICON "../../resources/windows/layerc_editor.ico"

IDR_EDITOR_MENU MENU
BEGIN
  POPUP "&File"
  BEGIN
    MENUITEM "&New profile\tCtrl+N", IDM_FILE_NEW
    MENUITEM "&Save\tCtrl+S", IDM_FILE_SAVE
    MENUITEM "Save &as...\tCtrl+Shift+S", IDM_FILE_SAVE_AS
    MENUITEM "D&uplicate profile", IDM_PROFILE_DUPLICATE
    MENUITEM "&Delete profile...", IDM_FILE_DELETE
    MENUITEM SEPARATOR
    MENUITEM "&Import pack...", IDM_FILE_IMPORT_PACK
    MENUITEM "&Export pack...", IDM_FILE_EXPORT_PACK
    MENUITEM SEPARATOR
    MENUITEM "Open profiles &folder", IDM_FILE_OPEN_FOLDER
    MENUITEM SEPARATOR
    MENUITEM "E&xit", IDM_FILE_EXIT
  END
  POPUP "&Edit"
  BEGIN
    MENUITEM "&Undo\tCtrl+Z", IDM_EDIT_UNDO
    MENUITEM "&Redo\tCtrl+Y", IDM_EDIT_REDO
    MENUITEM SEPARATOR
    MENUITEM "&Add cooldown", IDM_COOLDOWN_ADD
    MENUITEM "D&uplicate cooldown\tCtrl+D", IDM_COOLDOWN_DUPLICATE
    MENUITEM "Re&name cooldown\tF2", IDM_COOLDOWN_RENAME
    MENUITEM "Remove c&ooldown...\tDel", IDM_COOLDOWN_REMOVE
  END
  POPUP "&View"
  BEGIN
    MENUITEM "Show &advanced settings\tCtrl+Shift+A", IDM_VIEW_ADVANCED
    POPUP "&Text size"
    BEGIN
      MENUITEM "&100 %", IDM_VIEW_TEXT_100
      MENUITEM "11&5 %", IDM_VIEW_TEXT_115
      MENUITEM "1&30 %", IDM_VIEW_TEXT_130
    END
  END
  POPUP "&Tools"
  BEGIN
    MENUITEM "&Options...\tCtrl+,", IDM_FILE_OPTIONS
    MENUITEM "A&ppearance...", IDM_TOOLS_APPEARANCE
    MENUITEM "&Automation...", IDM_FILE_AUTOMATION
    MENUITEM SEPARATOR
    MENUITEM "Split grouped &bars...", IDM_FILE_SPLIT_BARS
  END
  POPUP "&Help"
  BEGIN
    MENUITEM "&Keyboard shortcuts\tF1", IDM_HELP_SHORTCUTS
    MENUITEM "Runtime &diagnostics...", IDM_FILE_RUNTIME_DIAGNOSTICS
    MENUITEM SEPARATOR
    MENUITEM "&About LayerC Editor", IDM_HELP_ABOUT
  END
END

// The themed prompt (editor_prompt.cpp sizes and labels it at runtime).
IDD_PROMPT DIALOGEX 0, 0, 240, 80
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
  LTEXT "", IDC_PROMPT_TEXT, 8, 8, 224, 40, SS_NOPREFIX
  PUSHBUTTON "", IDC_PROMPT_BUTTON1, 60, 56, 50, 17
  PUSHBUTTON "", IDC_PROMPT_BUTTON2, 116, 56, 50, 17
  PUSHBUTTON "", IDC_PROMPT_BUTTON3, 172, 56, 50, 17
END

// Context menus: profile row and cooldown row.
IDR_CONTEXT_MENUS MENU
BEGIN
  POPUP "Profile"
  BEGIN
    MENUITEM "Re&name", IDM_PROFILE_RENAME
    MENUITEM "D&uplicate", IDM_PROFILE_DUPLICATE
    MENUITEM "&Turn on", IDM_PROFILE_TOGGLE
    MENUITEM SEPARATOR
    MENUITEM "&Export pack...", IDM_FILE_EXPORT_PACK
    MENUITEM SEPARATOR
    MENUITEM "&Delete...", IDM_FILE_DELETE
  END
  POPUP "Cooldown"
  BEGIN
    MENUITEM "Re&name\tF2", IDM_COOLDOWN_RENAME
    MENUITEM "D&uplicate\tCtrl+D", IDM_COOLDOWN_DUPLICATE
    MENUITEM SEPARATOR
    MENUITEM "&Remove...\tDel", IDM_COOLDOWN_REMOVE
  END
END

IDD_PANEL_ITEM DIALOGEX 0, 0, 360, 272
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Overlay item"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "&Kind", IDC_ITEM_KIND_LABEL, 12, 14, 74, 10
  COMBOBOX IDC_ITEM_KIND, 90, 11, 258, 110, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
  LTEXT "Timer &source", IDC_ITEM_TIMER_LABEL, 12, 38, 74, 10
  COMBOBOX IDC_ITEM_TIMER_SOURCE, 90, 35, 258, 80, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
  CONTROL "Create timer &preset", IDC_ITEM_PRESET, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 90, 58, 258, 14
  LTEXT "&Source", IDC_ITEM_SOURCE_LABEL, 12, 82, 74, 10
  COMBOBOX IDC_ITEM_SOURCE, 90, 79, 258, 110, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
  CONTROL "&Custom label", IDC_ITEM_CUSTOM_LABEL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 106, 74, 14
  EDITTEXT IDC_ITEM_LABEL, 90, 104, 258, 15, ES_AUTOHSCROLL
  LTEXT "Counter &max", IDC_ITEM_MAX_LABEL, 12, 134, 74, 10
  EDITTEXT IDC_ITEM_MAX, 90, 131, 90, 15, ES_AUTOHSCROLL
  LTEXT "&Display", IDC_ITEM_DISPLAY_LABEL, 194, 134, 48, 10
  COMBOBOX IDC_ITEM_DISPLAY, 246, 131, 102, 70, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
  LTEXT "&Flash (Hz)", IDC_ITEM_FLASH_LABEL, 12, 158, 74, 10
  COMBOBOX IDC_ITEM_FLASH, 90, 155, 120, 100, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
  LTEXT "&Interval (s)", IDC_ITEM_INTERVAL_LABEL, 12, 182, 74, 10
  EDITTEXT IDC_ITEM_INTERVAL, 90, 179, 120, 15, ES_AUTOHSCROLL
  LTEXT "", IDC_ITEM_ERROR, 12, 204, 336, 32, SS_NOPREFIX
  DEFPUSHBUTTON "&Apply item", IDOK, 212, 242, 66, 19
  PUSHBUTTON "Cancel", IDCANCEL, 284, 242, 64, 19
END

IDD_EXPORT_PACK DIALOGEX 0, 0, 470, 310
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Export LayerC profile pack"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Select profiles to include. Only valid primary documents and referenced assets are exported.", IDC_PACK_INTRO, 12, 12, 440, 20
  CONTROL "", IDC_PACK_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 12, 38, 446, 205
  PUSHBUTTON "Select &all", IDC_PACK_SELECT_ALL, 12, 250, 66, 18
  LTEXT "0 profiles selected", IDC_PACK_SUMMARY, 88, 254, 230, 12
  DEFPUSHBUTTON "&Export...", IDC_PACK_CONFIRM, 332, 280, 60, 18
  PUSHBUTTON "Cancel", IDCANCEL, 398, 280, 60, 18
END

IDD_IMPORT_PACK DIALOGEX 0, 0, 610, 330
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Import LayerC profile pack"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "The archive passed complete validation. Select profiles, then import a copy or replace each conflict.", IDC_PACK_INTRO, 12, 12, 580, 20
  CONTROL "", IDC_PACK_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 12, 38, 586, 225
  PUSHBUTTON "Select &all", IDC_PACK_SELECT_ALL, 12, 270, 66, 18
  PUSHBUTTON "&Toggle copy / replace", IDC_PACK_TOGGLE_ACTION, 84, 270, 112, 18
  LTEXT "0 profiles selected", IDC_PACK_SUMMARY, 206, 274, 230, 12
  DEFPUSHBUTTON "&Import", IDC_PACK_CONFIRM, 472, 300, 60, 18
  PUSHBUTTON "Cancel", IDCANCEL, 538, 300, 60, 18
END

IDD_RUNTIME_DIAGNOSTICS DIALOGEX 0, 0, 620, 390
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | WS_THICKFRAME | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
CAPTION "Runtime diagnostics"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Current LayerD health and one-shot runtime snapshot. No trace is retained after this dialog closes.", IDC_DIAGNOSTICS_INTRO, 12, 12, 590, 18
  LTEXT "", IDC_DIAGNOSTICS_SUMMARY, 12, 36, 596, 62, SS_NOPREFIX
  CONTROL "Show &raw JSON", IDC_DIAGNOSTICS_RAW_TOGGLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 104, 100, 14
  EDITTEXT IDC_DIAGNOSTICS_TEXT, 12, 124, 596, 218, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
  PUSHBUTTON "Re&fresh snapshot", IDC_DIAGNOSTICS_REFRESH, 12, 356, 90, 19
  PUSHBUTTON "&Copy raw JSON", IDC_DIAGNOSTICS_COPY, 108, 356, 86, 19
  PUSHBUTTON "Retry &visual", IDC_DIAGNOSTICS_RETRY_VISUAL, 200, 356, 76, 19
  DEFPUSHBUTTON "Close", IDOK, 548, 356, 60, 19
END

IDD_HID_BINDING DIALOGEX 0, 0, 470, 252
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Capture generic HID binding"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "&Device", -1, 12, 14, 50, 10
  COMBOBOX IDC_HID_DEVICE, 68, 11, 330, 120, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON "C&apture", IDC_HID_CAPTURE, 404, 11, 54, 18
  LTEXT "Select a device, choose Capture, then actuate one button, hat, trigger, or axis direction.", IDC_HID_SUMMARY, 12, 40, 446, 34
  LTEXT "&Threshold %", -1, 12, 86, 60, 10
  EDITTEXT IDC_HID_THRESHOLD, 76, 83, 44, 15, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "&Hysteresis %", -1, 136, 86, 68, 10
  EDITTEXT IDC_HID_HYSTERESIS, 208, 83, 44, 15, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "&Stable slot", -1, 268, 86, 52, 10
  EDITTEXT IDC_HID_SLOT, 324, 83, 44, 15, ES_NUMBER | ES_AUTOHSCROLL
  CONTROL "Advanced: allow &keyboard/mouse-class HID (may duplicate normal input)", IDC_HID_SYSTEM_CLASS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 116, 430, 14
  LTEXT "LayerC reads ordinary Raw Input only while this binding is active. It installs no driver, claims no device, and sends no synthetic input.", -1, 12, 148, 446, 34
  DEFPUSHBUTTON "&Use binding", IDC_HID_APPLY, 326, 220, 66, 19
  PUSHBUTTON "Cancel", IDCANCEL, 398, 220, 60, 19
END

IDD_AUTOMATION DIALOGEX 0, 0, 570, 370
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "Automation"
FONT 9, "Segoe UI"
