#include "editor_resource.h"
#include <windows.h>

IDR_EDITOR_MENU MENU
BEGIN
  POPUP "&File"
  BEGIN
    MENUITEM "&New Profile\tCtrl+N", IDM_FILE_NEW
    MENUITEM "&Save\tCtrl+S", IDM_FILE_SAVE
    MENUITEM "Save &As...", IDM_FILE_SAVE_AS
    MENUITEM "&Delete Profile", IDM_FILE_DELETE
    MENUITEM SEPARATOR
    MENUITEM "&Import Pack...", IDM_FILE_IMPORT_PACK
    MENUITEM "E&xport Pack...", IDM_FILE_EXPORT_PACK
    MENUITEM SEPARATOR
    MENUITEM "Open Profiles &Folder", IDM_FILE_OPEN_FOLDER
    MENUITEM SEPARATOR
    MENUITEM "E&xit", IDM_FILE_EXIT
  END
  POPUP "&Edit"
  BEGIN
    MENUITEM "&Undo\tCtrl+Z", IDM_EDIT_UNDO
    MENUITEM "&Redo\tCtrl+Y", IDM_EDIT_REDO
  END
  POPUP "&Tools"
  BEGIN
    MENUITEM "&Options...", IDM_FILE_OPTIONS
    MENUITEM "&Appearance...", IDM_TOOLS_APPEARANCE
    MENUITEM "&Automation...", IDM_FILE_AUTOMATION
    MENUITEM SEPARATOR
    MENUITEM "Split Grouped &Bars...", IDM_FILE_SPLIT_BARS
  END
  POPUP "&Help"
  BEGIN
    MENUITEM "Runtime &Diagnostics...", IDM_FILE_RUNTIME_DIAGNOSTICS
    MENUITEM SEPARATOR
    MENUITEM "&About LayerC Editor", IDM_HELP_ABOUT
  END
END

IDD_EXPORT_PACK DIALOGEX 0, 0, 470, 310
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME | WS_THICKFRAME
CAPTION "Export LayerC Profile Pack"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Select profiles to include. Only valid primary documents and referenced assets are exported.", IDC_PACK_INTRO, 12, 12, 440, 20
