  LTEXT "RGB 0-255 or #RRGGBB", -1, 12, 200, 145, 10
  DEFPUSHBUTTON "OK", IDOK, 236, 190, 52, 19
  PUSHBUTTON "Cancel", IDCANCEL, 294, 190, 52, 19
END
