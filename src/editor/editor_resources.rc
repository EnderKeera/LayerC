#include "editor_resource.h"
#include <windows.h>

IDR_EDITOR_MENU MENU
BEGIN
  POPUP "&File"
  BEGIN
    MENUITEM "&New\tCtrl+N", IDM_FILE_NEW
    MENUITEM "&Save\tCtrl+S", IDM_FILE_SAVE
    MENUITEM "Save &As...", IDM_FILE_SAVE_AS
    MENUITEM SEPARATOR
    MENUITEM "&Delete Profile...", IDM_FILE_DELETE
    MENUITEM "Open Profiles &Folder", IDM_FILE_OPEN_FOLDER
    MENUITEM SEPARATOR
    MENUITEM "E&xit", IDM_FILE_EXIT
  END
END

IDR_EDITOR_ACCELERATORS ACCELERATORS
BEGIN
  "N", IDM_FILE_NEW, VIRTKEY, CONTROL
  "S", IDM_FILE_SAVE, VIRTKEY, CONTROL
END

IDD_EDITOR DIALOGEX 0, 0, 970, 630
STYLE DS_SHELLFONT | WS_OVERLAPPEDWINDOW | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_APPWINDOW
CAPTION "LayerE"
FONT 9, "Segoe UI"
BEGIN
  PUSHBUTTON "File", IDC_FILE_MENU, 8, 8, 36, 16
  PUSHBUTTON "New", IDC_NEW_PROFILE, 8, 8, 42, 16
  PUSHBUTTON "Save", IDC_SAVE_PROFILE, 54, 8, 42, 16
  PUSHBUTTON "Attach", IDC_ATTACH, 100, 8, 48, 16
  PUSHBUTTON "Detected Tasks", IDC_SHOW_TASKS, 152, 8, 75, 16
  PUSHBUTTON "Split into independent bars", IDC_SPLIT_BARS, 231, 8, 112, 16
  PUSHBUTTON "Options", IDC_OPTIONS, 347, 8, 50, 16

  LTEXT "SAVED PROFILES", IDC_SAVED_PROFILES_LABEL, 8, 33, 160, 10
  CONTROL "", IDC_PROFILE_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 45, 205, 475
  PUSHBUTTON "Attach", IDC_ATTACH_LEFT, 8, 525, 68, 18
  PUSHBUTTON "Detected Tasks", IDC_SHOW_TASKS_LEFT, 80, 525, 105, 18

  LTEXT "PROFILE", IDC_PROFILE_SECTION_LABEL, 225, 34, 100, 10
  LTEXT "Profile name", IDC_PROFILE_NAME_LABEL, 225, 48, 58, 10
  EDITTEXT IDC_PROFILE_NAME, 286, 46, 250, 14, ES_AUTOHSCROLL
  LTEXT "Profile ID", IDC_PROFILE_ID_LABEL, 225, 66, 58, 10
  EDITTEXT IDC_PROFILE_ID, 286, 64, 250, 14, ES_AUTOHSCROLL
  LTEXT "Application", IDC_APPLICATION_LABEL, 225, 84, 58, 10
  EDITTEXT IDC_APPLICATION_PATH, 286, 82, 390, 14, ES_AUTOHSCROLL | ES_READONLY

  LTEXT "COOLDOWNS", IDC_COOLDOWNS_LABEL, 225, 108, 100, 10
  LISTBOX IDC_COOLDOWN_LIST, 225, 121, 310, 88, LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_BORDER | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON "Add", IDC_ADD_COOLDOWN, 541, 121, 48, 18
  PUSHBUTTON "Remove", IDC_REMOVE_COOLDOWN, 541, 145, 48, 18
  LTEXT "Binding", IDC_COOLDOWN_BINDING_LABEL, 225, 211, 42, 10
  EDITTEXT IDC_COOLDOWN_BINDING, 270, 209, 190, 14, ES_AUTOHSCROLL | ES_READONLY
  PUSHBUTTON "Capture key", IDC_CAPTURE_BINDING, 466, 208, 69, 18

  LTEXT "BARS", IDC_BARS_LABEL, 225, 235, 100, 10
  LISTBOX IDC_BAR_LIST, 225, 232, 200, 112, LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_BORDER | WS_VSCROLL | WS_TABSTOP
  LTEXT "Selected bar", IDC_SELECTED_BAR_LABEL, 435, 232, 75, 10
  LTEXT "Width", IDC_WIDTH_LABEL, 435, 248, 30, 10
  EDITTEXT IDC_BAR_WIDTH, 469, 246, 42, 14, ES_AUTOHSCROLL | ES_NUMBER
  LTEXT "Height", IDC_HEIGHT_LABEL, 518, 248, 30, 10
  EDITTEXT IDC_BAR_HEIGHT, 552, 246, 42, 14, ES_AUTOHSCROLL | ES_NUMBER
  PUSHBUTTON "Fill", IDC_BAR_FILL, 435, 269, 77, 18
  PUSHBUTTON "Background", IDC_BAR_BACKGROUND, 517, 269, 77, 18
  PUSHBUTTON "Border", IDC_BAR_BORDER, 435, 292, 77, 18
  PUSHBUTTON "Text", IDC_BAR_TEXT, 517, 292, 77, 18
  CONTROL "Hide when ready", IDC_HIDE_READY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 435, 318, 120, 14
  LTEXT "Drag the selected bar in the preview to position it.", IDC_POSITION_STATUS, 225, 352, 390, 10

  LTEXT "PREVIEW", IDC_PREVIEW_LABEL, 615, 34, 90, 10
  CONTROL "", IDC_PREVIEW, "Static", SS_BLACKFRAME | WS_TABSTOP, 615, 47, 347, 450
  LTEXT "Ready", IDC_STATUS, 8, 558, 950, 12
END

IDD_TASKS DIALOGEX 0, 0, 610, 340
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Detected Tasks"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "DETECTED TASKS", -1, 10, 10, 160, 10
  CONTROL "", IDC_TASK_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 25, 590, 244
  PUSHBUTTON "Pick Window", IDC_PICK_WINDOW, 10, 280, 72, 18
  PUSHBUTTON "Use Selected Task", IDC_USE_TASK, 88, 280, 95, 18
  PUSHBUTTON "Refresh", IDC_REFRESH_TASKS, 189, 280, 54, 18
  LTEXT "Select a task to see its executable path.", IDC_TASK_DETAIL, 10, 306, 590, 14
END

IDD_OPTIONS DIALOGEX 0, 0, 300, 156
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "LayerE Options"
FONT 9, "Segoe UI"
BEGIN
  CONTROL "Exclude LayerE and overlays from software capture", IDC_CAPTURE_PRIVACY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 14, 265, 14
  LTEXT "Preset", -1, 12, 42, 42, 10
  LISTBOX IDC_THEME_PRESET, 58, 40, 180, 45, LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_BORDER | WS_TABSTOP
  PUSHBUTTON "Appearance...", IDC_OPEN_APPEARANCE, 12, 92, 82, 18
  DEFPUSHBUTTON "Apply", IDC_OPTIONS_APPLY, 156, 124, 58, 18
  PUSHBUTTON "Cancel", IDCANCEL, 220, 124, 58, 18
END

IDD_APPEARANCE DIALOGEX 0, 0, 500, 305
STYLE DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Appearance"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Control tree", -1, 12, 12, 70, 10
  LISTBOX IDC_APPEARANCE_TREE, 12, 26, 150, 214, LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_BORDER | WS_VSCROLL | WS_TABSTOP
  LTEXT "Override colors for the selected control", -1, 176, 12, 240, 10
  PUSHBUTTON "Fill", IDC_APPEARANCE_FILL, 176, 30, 86, 19
  PUSHBUTTON "Text", IDC_APPEARANCE_TEXT, 270, 30, 86, 19
  PUSHBUTTON "Border", IDC_APPEARANCE_BORDER, 364, 30, 86, 19
  PUSHBUTTON "Hover", IDC_APPEARANCE_HOVER, 176, 56, 86, 19
  PUSHBUTTON "Selection", IDC_APPEARANCE_SELECTION, 270, 56, 86, 19
  PUSHBUTTON "Disabled", IDC_APPEARANCE_DISABLED, 364, 56, 86, 19
  PUSHBUTTON "Reset selected overrides", IDC_APPEARANCE_RESET, 176, 88, 140, 19
  LTEXT "Preview", -1, 176, 122, 70, 10
  CONTROL "", IDC_APPEARANCE_PREVIEW, "Static", SS_BLACKFRAME, 176, 137, 274, 103
  DEFPUSHBUTTON "Close", IDOK, 392, 266, 58, 19
END
