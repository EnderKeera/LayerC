  LTEXT "&Target", IDC_AUTOMATION_TARGET_LABEL, 268, 184, 44, 10
  EDITTEXT IDC_AUTOMATION_TARGET, 350, 181, 211, 15, ES_AUTOHSCROLL
  LTEXT "Val&ue", IDC_AUTOMATION_VALUE_LABEL, 268, 204, 44, 10
  EDITTEXT IDC_AUTOMATION_VALUE, 350, 201, 211, 15, ES_AUTOHSCROLL
  CONTROL "Repeatin&g timer", IDC_AUTOMATION_REPEATING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 350, 222, 92, 14
  PUSHBUTTON "Appl&y item", IDC_AUTOMATION_APPLY_NODE, 350, 241, 65, 19
  PUSHBUTTON "Delete ite&m", IDC_AUTOMATION_DELETE_NODE, 420, 241, 65, 19
  LTEXT "Validation", IDC_AUTOMATION_VALIDATION_LABEL, 9, 307, 56, 10
  LISTBOX IDC_AUTOMATION_VALIDATION, 68, 303, 359, 22, LBS_NOTIFY | LBS_HASSTRINGS | WS_BORDER | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON "Validate", IDC_AUTOMATION_VALIDATE, 432, 302, 58, 19
