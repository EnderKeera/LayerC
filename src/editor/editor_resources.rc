  PUSHBUTTON "", IDC_COLOR_SWATCH_7, 285, 25, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_8, 12, 52, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_9, 51, 52, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_10, 90, 52, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_11, 129, 52, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_12, 168, 52, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_13, 207, 52, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_14, 246, 52, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_15, 285, 52, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_16, 12, 79, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_17, 51, 79, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_18, 90, 79, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_19, 129, 79, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_20, 168, 79, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_21, 207, 79, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_22, 246, 79, 32, 20
  PUSHBUTTON "", IDC_COLOR_SWATCH_23, 285, 79, 32, 20

  LTEXT "CUSTOM COLOR", -1, 12, 111, 100, 10
