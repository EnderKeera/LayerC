  PUSHBUTTON "Pla&y", IDC_AUTOMATION_SIM_PLAY, 103, 94, 40, 19
  LTEXT "Playbac&k speed", IDC_AUTOMATION_SIM_SPEED_LABEL, 148, 98, 60, 10
  COMBOBOX IDC_AUTOMATION_SIM_SPEED, 210, 96, 40, 80, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
  CONTROL "Live tra&ce", IDC_AUTOMATION_TRACE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 226, 97, 65, 14
  PUSHBUTTON "L&oad trace...", IDC_AUTOMATION_TRACE_LOAD, 296, 94, 72, 19
  PUSHBUTTON "Save trace...", IDC_AUTOMATION_SAVE_TRACE, 373, 94, 72, 19
  LTEXT "Breakpoint r&ule", IDC_AUTOMATION_SIM_BREAKPOINT_LABEL, 9, 122, 76, 10
  EDITTEXT IDC_AUTOMATION_SIM_BREAKPOINT, 88, 119, 128, 15, ES_AUTOHSCROLL
  LTEXT "Assert&ions (id=JSON; ...)", IDC_AUTOMATION_SIM_ASSERTIONS_LABEL, 226, 122, 118, 10
  EDITTEXT IDC_AUTOMATION_SIM_ASSERTIONS, 347, 119, 214, 15, ES_AUTOHSCROLL
  LTEXT "Trace", IDC_AUTOMATION_SIM_TRACE_LABEL, 9, 144, 50, 10
  EDITTEXT IDC_AUTOMATION_TRACE_TEXT, 9, 157, 552, 143, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP

  DEFPUSHBUTTON "Close", IDOK, 501, 342, 60, 19
END
IDR_EDITOR_ACCELERATORS ACCELERATORS
BEGIN
  "N", IDM_FILE_NEW, VIRTKEY, CONTROL
  "S", IDM_FILE_SAVE, VIRTKEY, CONTROL
  "Z", IDM_EDIT_UNDO, VIRTKEY, CONTROL
  "Y", IDM_EDIT_REDO, VIRTKEY, CONTROL
  "S", IDM_FILE_SAVE_AS, VIRTKEY, CONTROL, SHIFT
  "D", IDM_COOLDOWN_DUPLICATE, VIRTKEY, CONTROL
  "A", IDM_VIEW_ADVANCED, VIRTKEY, CONTROL, SHIFT
  VK_OEM_COMMA, IDM_FILE_OPTIONS, VIRTKEY, CONTROL
  VK_F1, IDM_HELP_SHORTCUTS, VIRTKEY
END

IDD_EDITOR DIALOGEX 0, 0, 970, 630
STYLE DS_SHELLFONT | WS_OVERLAPPEDWINDOW | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_APPWINDOW
CAPTION "LayerC Editor"
MENU IDR_EDITOR_MENU
FONT 9, "Segoe UI"
BEGIN
  // Positions are placeholders: EditorWindow::layout() places every control.
  // Creation order is the tab order.
  LTEXT "Profiles", IDC_SAVED_PROFILES_LABEL, 8, 8, 100, 10
  CONTROL "", IDC_PROFILE_LIST, "SysListView32", LVS_REPORT | LVS_OWNERDRAWFIXED | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP, 8, 20, 100, 100
  PUSHBUTTON "+", IDC_PROFILE_NEW, 8, 124, 20, 16
  PUSHBUTTON "-", IDC_PROFILE_DELETE, 30, 124, 20, 16
  PUSHBUTTON "...", IDC_PROFILE_MORE, 52, 124, 20, 16

  LTEXT "Panel &items", IDC_PANEL_ITEMS_LABEL, 8, 150, 100, 10
  LISTBOX IDC_PANEL_ITEMS, 8, 164, 100, 60, LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON "&Add...", IDC_ITEM_ADD, 8, 230, 30, 16
  PUSHBUTTON "&Edit...", IDC_ITEM_EDIT, 42, 230, 30, 16
  PUSHBUTTON "&Remove", IDC_ITEM_REMOVE, 76, 230, 32, 16
  PUSHBUTTON "Move &up", IDC_ITEM_UP, 8, 250, 48, 16
  PUSHBUTTON "Move &down", IDC_ITEM_DOWN, 60, 250, 48, 16
  LTEXT "", IDC_ITEM_REASON, 8, 270, 100, 20, SS_NOPREFIX | NOT WS_VISIBLE

  LTEXT "", IDC_PROFILE_TITLE, 120, 8, 200, 14, SS_NOPREFIX | SS_ENDELLIPSIS
  LTEXT "Profile", IDC_PROFILE_SECTION_LABEL, 120, 8, 60, 10, NOT WS_VISIBLE
  LTEXT "Profile &name", IDC_PROFILE_NAME_LABEL, 120, 28, 58, 10
  EDITTEXT IDC_PROFILE_NAME, 180, 26, 200, 14, ES_AUTOHSCROLL
  LTEXT "Profile &ID", IDC_PROFILE_ID_LABEL, 120, 44, 58, 10
  EDITTEXT IDC_PROFILE_ID, 180, 42, 200, 14, ES_AUTOHSCROLL
  LTEXT "&Application", IDC_APPLICATION_LABEL, 120, 60, 58, 10
  EDITTEXT IDC_APPLICATION_PATH, 180, 58, 120, 14, ES_AUTOHSCROLL
  PUSHBUTTON "&Browse...", IDC_BROWSE_APPLICATION, 304, 58, 40, 16
  PUSHBUTTON "Choose &running...", IDC_CHOOSE_APPLICATION, 348, 58, 60, 16
  CONTROL "Match e&xact path", IDC_APPLICATION_EXACT_PATH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 180, 76, 120, 14
  PUSHBUTTON "Show advanced", IDC_ADVANCED, 330, 8, 60, 16

  LTEXT "Cool&downs", IDC_COOLDOWNS_LABEL, 120, 96, 100, 10
  LISTBOX IDC_COOLDOWN_LIST, 120, 108, 200, 60, LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON "Add coo&ldown", IDC_ADD_COOLDOWN, 324, 108, 60, 16
  PUSHBUTTON "Remove cooldo&wn", IDC_REMOVE_COOLDOWN, 324, 128, 60, 16
  LTEXT "", IDC_COOLDOWN_REMOVE_REASON, 324, 148, 60, 20, SS_NOPREFIX | NOT WS_VISIBLE

  // The preview corner, read after the list; layout() moves Position on
  // window into the look slot when the preview hides.
  LTEXT "Preview", IDC_PREVIEW_LABEL, 600, 8, 90, 10
  PUSHBUTTON "&Position on window", IDC_POSITION_ON_WINDOW, 700, 6, 80, 16
  CONTROL "", IDC_PREVIEW, "Static", SS_BLACKFRAME | SS_NOTIFY | WS_TABSTOP, 600, 24, 200, 150

  LTEXT "Timing and key", IDC_TIMING_LABEL, 120, 176, 100, 10
  LTEXT "Na&me", IDC_COOLDOWN_NAME_LABEL, 120, 190, 42, 10
  EDITTEXT IDC_COOLDOWN_NAME, 164, 188, 100, 14, ES_AUTOHSCROLL
  LTEXT "D&uration (s)", IDC_COOLDOWN_DURATION_LABEL, 120, 206, 42, 10
  EDITTEXT IDC_COOLDOWN_DURATION, 164, 204, 40, 14, ES_AUTOHSCROLL
  LTEXT "Active (ms)", IDC_COOLDOWN_ACTIVE_LABEL, 120, 220, 42, 10
  EDITTEXT IDC_COOLDOWN_ACTIVE, 164, 218, 48, 14, ES_AUTOHSCROLL | ES_NUMBER
  LTEXT "0 = off", IDC_COOLDOWN_ACTIVE_HINT, 216, 220, 40, 10
  LTEXT "Bindin&g", IDC_COOLDOWN_BINDING_LABEL, 120, 222, 42, 10
  EDITTEXT IDC_COOLDOWN_BINDING, 164, 220, 100, 14, ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
  PUSHBUTTON "Capture &key", IDC_CAPTURE_BINDING, 268, 220, 50, 16
  PUSHBUTTON "HID...", IDC_CAPTURE_HID, 322, 220, 40, 16
  LTEXT "ID", IDC_COOLDOWN_ID_LABEL, 120, 238, 42, 10
  EDITTEXT IDC_COOLDOWN_ID, 164, 236, 100, 14, ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
  LTEXT "Charges", IDC_COOLDOWN_CHARGES_LABEL, 268, 238, 42, 10
  EDITTEXT IDC_COOLDOWN_CHARGES, 312, 236, 38, 14, ES_AUTOHSCROLL | ES_NUMBER
  LTEXT "Retrigger", IDC_COOLDOWN_RETRIGGER_LABEL, 120, 254, 42, 10
  COMBOBOX IDC_COOLDOWN_RETRIGGER, 164, 252, 80, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
  LTEXT "Recovery", IDC_COOLDOWN_RECOVERY_LABEL, 248, 254, 42, 10
  COMBOBOX IDC_COOLDOWN_RECOVERY, 292, 252, 80, 70, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
  LTEXT "Groups", IDC_COOLDOWN_GROUPS_LABEL, 120, 270, 42, 10
