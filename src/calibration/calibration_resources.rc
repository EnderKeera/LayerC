#include "calibration_resource.h"
#include <windows.h>

IDD_CALIBRATION DIALOGEX 0, 0, 900, 580
STYLE DS_SHELLFONT | WS_OVERLAPPEDWINDOW | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "LayerC Visual Calibration"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Drag on the preview to select the region to watch.", -1, 12, 10, 575, 12
  CONTROL "", IDC_CAL_PREVIEW, "Static", SS_OWNERDRAW | SS_NOTIFY | WS_BORDER | WS_TABSTOP, 12, 27, 590, 520

  LTEXT "Target", -1, 620, 12, 48, 10
  LTEXT "", IDC_CAL_TARGET, 620, 25, 260, 28
  LTEXT "Capture", -1, 620, 58, 48, 10
  LTEXT "Starting...", IDC_CAL_BACKEND, 620, 71, 260, 30

  LTEXT "Predicate", -1, 620, 108, 62, 10
  COMBOBOX IDC_CAL_PREDICATE, 620, 121, 260, 72, CBS_DROPDOWNLIST | WS_TABSTOP
  PUSHBUTTON "Sample target from region", IDC_CAL_SAMPLE_COLOR, 620, 150, 150, 20
  LTEXT "#000000", IDC_CAL_COLOR_VALUE, 778, 154, 72, 12
  LTEXT "Tolerance", -1, 620, 181, 55, 10
  EDITTEXT IDC_CAL_TOLERANCE, 681, 178, 48, 16, ES_NUMBER | ES_AUTOHSCROLL
  COMBOBOX IDC_CAL_COMPARISON, 738, 177, 67, 48, CBS_DROPDOWNLIST | WS_TABSTOP
  LTEXT "Threshold", -1, 620, 207, 55, 10
  EDITTEXT IDC_CAL_THRESHOLD, 681, 204, 48, 16, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "Min %", -1, 738, 207, 40, 10
  EDITTEXT IDC_CAL_MINIMUM_PERCENT, 784, 204, 48, 16, ES_NUMBER | ES_AUTOHSCROLL

  LTEXT "Stable samples", -1, 620, 238, 76, 10
  EDITTEXT IDC_CAL_STABLE_SAMPLES, 702, 235, 48, 16, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "Repeat", -1, 758, 238, 38, 10
  COMBOBOX IDC_CAL_REPEAT, 800, 234, 80, 55, CBS_DROPDOWNLIST | WS_TABSTOP

  LTEXT "Trigger", -1, 620, 269, 48, 10
  COMBOBOX IDC_CAL_TRIGGER_MODE, 674, 265, 206, 55, CBS_DROPDOWNLIST | WS_TABSTOP
  CONTROL "Keep input binding", IDC_CAL_KEEP_INPUT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 620, 294, 112, 14
  LTEXT "Confirm ms", -1, 740, 296, 58, 10
  EDITTEXT IDC_CAL_TIMEOUT, 804, 292, 76, 16, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "If capture fails", -1, 620, 323, 80, 10
  COMBOBOX IDC_CAL_UNAVAILABLE, 706, 319, 174, 55, CBS_DROPDOWNLIST | WS_TABSTOP

  LTEXT "Sample rate", -1, 620, 356, 66, 10
  COMBOBOX IDC_CAL_SAMPLE_RATE, 692, 352, 75, 65, CBS_DROPDOWNLIST | WS_TABSTOP
  LTEXT "Quality", -1, 775, 356, 42, 10
  COMBOBOX IDC_CAL_QUALITY, 820, 352, 60, 65, CBS_DROPDOWNLIST | WS_TABSTOP
  LTEXT "Exact evaluates every region pixel and is outside the Low/Balanced performance budget.", -1, 620, 382, 260, 28

  LTEXT "Waiting for a frame...", IDC_CAL_MATCH, 620, 424, 260, 44
  DEFPUSHBUTTON "Apply", IDC_CAL_APPLY, 752, 528, 60, 22
  PUSHBUTTON "Cancel", IDCANCEL, 820, 528, 60, 22
END
