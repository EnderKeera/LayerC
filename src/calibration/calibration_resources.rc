#include "calibration_resource.h"
#include <windows.h>

// First icon: Explorer, taskbar and the title bar (set_window_app_icon).
1 ICON "../../resources/windows/layerc_calibration.ico"

IDD_CALIBRATION DIALOGEX 0, 0, 800, 510
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "LayerC Calibration"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "Drag on the preview to select the region to watch.", -1, 12, 10, 510, 12
  CONTROL "", IDC_CAL_PREVIEW, "Static", SS_OWNERDRAW | SS_NOTIFY | WS_BORDER | WS_TABSTOP, 12, 27, 510, 440

  LTEXT "Target", -1, 540, 12, 42, 10
  LTEXT "", IDC_CAL_TARGET, 586, 10, 202, 25
  LTEXT "Capture", -1, 540, 42, 42, 10
  LTEXT "Starting...", IDC_CAL_BACKEND, 586, 40, 202, 25

  LTEXT "Predicate", -1, 540, 72, 62, 10
  COMBOBOX IDC_CAL_PREDICATE, 540, 85, 248, 72, CBS_DROPDOWNLIST | WS_TABSTOP
  PUSHBUTTON "Sample target from region", IDC_CAL_SAMPLE_COLOR, 540, 114, 146, 20
  LTEXT "#000000", IDC_CAL_COLOR_VALUE, 694, 118, 72, 12
  LTEXT "Tolerance", -1, 540, 145, 55, 10
  EDITTEXT IDC_CAL_TOLERANCE, 601, 142, 48, 16, ES_NUMBER | ES_AUTOHSCROLL
  COMBOBOX IDC_CAL_COMPARISON, 658, 141, 67, 48, CBS_DROPDOWNLIST | WS_TABSTOP
  LTEXT "Threshold", -1, 540, 171, 55, 10
  EDITTEXT IDC_CAL_THRESHOLD, 601, 168, 48, 16, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "Min %", -1, 658, 171, 40, 10
  EDITTEXT IDC_CAL_MINIMUM_PERCENT, 704, 168, 48, 16, ES_NUMBER | ES_AUTOHSCROLL

  LTEXT "Stable samples", -1, 540, 197, 76, 10
  EDITTEXT IDC_CAL_STABLE_SAMPLES, 622, 194, 48, 16, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "Repeat", -1, 678, 197, 38, 10
  COMBOBOX IDC_CAL_REPEAT, 720, 193, 68, 55, CBS_DROPDOWNLIST | WS_TABSTOP

  LTEXT "Trigger", -1, 540, 224, 48, 10
  COMBOBOX IDC_CAL_TRIGGER_MODE, 594, 220, 194, 55, CBS_DROPDOWNLIST | WS_TABSTOP
  CONTROL "Keep input binding", IDC_CAL_KEEP_INPUT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 540, 249, 112, 14
  LTEXT "Confirm ms", -1, 660, 251, 58, 10
  EDITTEXT IDC_CAL_TIMEOUT, 724, 247, 64, 16, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "If capture fails", -1, 540, 278, 80, 10
  COMBOBOX IDC_CAL_UNAVAILABLE, 626, 274, 162, 55, CBS_DROPDOWNLIST | WS_TABSTOP

  LTEXT "Sample rate", -1, 540, 307, 66, 10
  COMBOBOX IDC_CAL_SAMPLE_RATE, 612, 303, 75, 65, CBS_DROPDOWNLIST | WS_TABSTOP
  LTEXT "Quality", -1, 695, 307, 42, 10
  COMBOBOX IDC_CAL_QUALITY, 740, 303, 48, 65, CBS_DROPDOWNLIST | WS_TABSTOP
  LTEXT "Exact retains full-resolution data and is outside the Low/Balanced performance budget.", -1, 540, 333, 248, 24

  LTEXT "Waiting for a frame...", IDC_CAL_MATCH, 540, 361, 248, 28
  GROUPBOX "Template matching", IDC_CAL_TEMPLATE_GROUP, 540, 393, 248, 82
  PUSHBUTTON "Capture", IDC_CAL_CAPTURE_TEMPLATE, 550, 408, 54, 18
  PUSHBUTTON "Import...", IDC_CAL_IMPORT_TEMPLATE, 609, 408, 50, 18
  PUSHBUTTON "Mask...", IDC_CAL_EDIT_TEMPLATE_MASK, 664, 408, 50, 18
  PUSHBUTTON "Clear", IDC_CAL_CLEAR_TEMPLATES, 719, 408, 57, 18
  LTEXT "No references", IDC_CAL_TEMPLATE_REFERENCES, 550, 430, 226, 12
  LTEXT "Confidence %", IDC_CAL_CONFIDENCE_LABEL, 550, 449, 68, 10
  EDITTEXT IDC_CAL_CONFIDENCE, 624, 445, 42, 16, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "Scale +/- %", IDC_CAL_SCALE_LABEL, 675, 449, 60, 10
  EDITTEXT IDC_CAL_SCALE_TOLERANCE, 741, 445, 35, 16, ES_NUMBER | ES_AUTOHSCROLL
  LTEXT "Selection sets size; search area expands 2x. Mask: left ignores, right restores.", IDC_CAL_TEMPLATE_HELP, 550, 462, 226, 10

  DEFPUSHBUTTON "Apply", IDC_CAL_APPLY, 660, 478, 60, 22
  PUSHBUTTON "Cancel", IDCANCEL, 728, 478, 60, 22
END
