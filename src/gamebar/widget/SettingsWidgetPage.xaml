<Page
    x:Class="LayerC.GameBar.SettingsWidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource LayerCBackgroundBrush}"
    XYFocusKeyboardNavigation="Enabled">
  <Grid Padding="16" RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="LayerC panel slots" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="ProfileText" Grid.Row="1" Opacity="0.8"
               Text="Waiting for an active LayerC session…" TextWrapping="Wrap" />
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="SlotsHost" Spacing="12" />
    </ScrollViewer>
    <Button x:Name="SaveButton" Grid.Row="3" HorizontalAlignment="Stretch"
            Content="Save slot preferences" Click="SaveClicked" IsEnabled="False" />
    <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap" Opacity="0.8" />
  </Grid>
</Page>
