{
  "version": 8,
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2026",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/layerc",
        "LAYERC_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release"
    },
    {
      "name": "vs2026-install-release",
      "displayName": "Install Visual Studio 2026 Release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "targets": ["install"]
    }
  ],
  "testPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "vs2026-release",
      "displayName": "Build, test, and install Visual Studio 2026 Release",
      "steps": [
        { "type": "configure", "name": "vs2026" },
        { "type": "build", "name": "vs2026-release" },
        { "type": "test", "name": "vs2026-release" },
        { "type": "build", "name": "vs2026-install-release" }
      ]
    }
  ]
}

