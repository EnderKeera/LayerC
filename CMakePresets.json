{
  "version": 8,
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2026",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/layerc",
        "LAYERC_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "mingw-ninja",
      "displayName": "MinGW-w64 Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/mingw-preset",
      "environment": {
        "PATH": "$env{MINGW_ROOT}/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++.exe",
        "CMAKE_RC_COMPILER": "windres.exe",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/layerc-mingw",
        "LAYERC_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci",
      "displayName": "CI Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/layerc",
        "LAYERC_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release"
    },
    {
      "name": "vs2026-install-release",
      "displayName": "Install Visual Studio 2026 Release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "targets": ["install"]
    },
    {
      "name": "mingw-ninja",
      "configurePreset": "mingw-ninja"
    },
    {
      "name": "mingw-ninja-install",
      "configurePreset": "mingw-ninja",
      "targets": ["install"]
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "ci-install",
      "configurePreset": "ci",
      "targets": ["install"]
    }
  ],
  "testPresets": [
    {
      "name": "vs2026-debug",
      "configurePreset": "vs2026",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "mingw-ninja",
      "configurePreset": "mingw-ninja",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": { "outputOnFailure": true }
    }
  ],
  "packagePresets": [
    {
      "name": "vs2026-release",
      "configurePreset": "vs2026",
      "configurations": ["Release"],
      "generators": ["ZIP"]
    },
    {
      "name": "mingw-ninja",
      "configurePreset": "mingw-ninja",
      "generators": ["ZIP"]
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "generators": ["ZIP"]
    }
  ],
  "workflowPresets": [
    {
      "name": "vs2026-release",
      "displayName": "Build, test, install, and package Visual Studio 2026 Release",
      "steps": [
        { "type": "configure", "name": "vs2026" },
        { "type": "build", "name": "vs2026-release" },
        { "type": "test", "name": "vs2026-release" },
        { "type": "build", "name": "vs2026-install-release" },
        { "type": "package", "name": "vs2026-release" }
      ]
    },
    {
      "name": "mingw-ninja",
      "displayName": "Build, test, install, and package MinGW-w64 Release",
      "steps": [
        { "type": "configure", "name": "mingw-ninja" },
        { "type": "build", "name": "mingw-ninja" },
        { "type": "test", "name": "mingw-ninja" },
        { "type": "build", "name": "mingw-ninja-install" },
        { "type": "package", "name": "mingw-ninja" }
      ]
    },
    {
      "name": "ci",
      "displayName": "CI Ninja Release",
      "steps": [
        { "type": "configure", "name": "ci" },
        { "type": "build", "name": "ci" },
        { "type": "test", "name": "ci" },
        { "type": "build", "name": "ci-install" },
        { "type": "package", "name": "ci" }
      ]
    }
  ]
}
