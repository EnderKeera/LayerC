# GitHub / MCP env for future sessions — copy to .env and fill
# .env is gitignored (*.env), never committed

# For `gh` CLI + git push
GH_TOKEN=ghp_YOUR_TOKEN_HERE

# For MCP server-github (same PAT, repo + workflow scopes)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_YOUR_TOKEN_HERE

# Optional: for MCP relay / other
# GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE
